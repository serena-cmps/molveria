# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Node (frontend/ already has its own .gitignore for node_modules, dist,
# etc. — this is only here in case anything runs from the repo root too)
node_modules/

# Environment / secrets
.env
.env.*
!.env.example

# PyTorch Geometric's auto-generated dataset cache — regenerated from
# data/*/raw/ the first time each dataset class runs
data/*/processed/

# Runtime-generated, not source: batch-upload inputs saved by the API,
# and dev-server logs
uploads/
uvicorn_out.log
uvicorn_err.log
