# Frontend — a separate deployable (Vercel), not part of the backend image
frontend/
node_modules/

# Training data and analysis scripts/output — not needed to serve the API
data/
dataset/
database/
explainability/
scripts/

# results/ is excluded wholesale, then the three checkpoints the API
# actually loads are explicitly re-included below (Dockerfile COPYs them
# individually anyway, but keeping this consistent avoids confusion if
# that ever changes to a directory-level COPY).
results/*
!results/best_tox21_multitask.pt
!results/best_esol.pt
!results/best_chembl_multitask.pt

# Runtime-generated, not source
uploads/
*.log

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Secrets — never baked into an image
.env
.env.*
!.env.example

# VCS / tooling / editor cruft
.git/
.gitignore
.dockerignore
.claude/
*.md
